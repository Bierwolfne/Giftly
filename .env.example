# PostgreSQL connection string (required) — the server connects via a pooled
# client and verifies the connection on startup.
DATABASE_URL=postgres://user:password@localhost:5432/giftly

# Stripe keys — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Optional: set a pre-created Price ID (recurring $9.99/month) from Stripe Dashboard.
# If omitted, the price is built inline on every checkout (fine for testing).
STRIPE_PRICE_ID=price_...

# Webhook signing secret — from Stripe Dashboard > Webhooks, or from `stripe listen` output
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL for Stripe success/cancel redirects (no trailing slash)
APP_URL=http://localhost:3000

# Claude API key — powers the autonomous agent (POST /agent).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the agent's model (defaults to claude-opus-4-8)
# AGENT_MODEL=claude-opus-4-8
